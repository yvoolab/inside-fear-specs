    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float neuronCount = 12 {"hint":"How many neuron towers surround the user (first 4 are the per-step focus points)", "widget":"slider", "min":6, "max":24, "step":1}'
